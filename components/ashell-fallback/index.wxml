<view class="ashell-fallback">
  <view class="ashell-fallback__hero">
    <view class="ashell-fallback__badge">账本模式</view>
    <view class="ashell-fallback__title">{{appName}}</view>
    <view class="ashell-fallback__subtitle">当前小程序正在账本模式下运行，此页面仅展示账本相关内容。</view>
  </view>

  <view class="ashell-fallback__card">
    <view class="ashell-fallback__card-title">今日记账提醒</view>
    <view class="ashell-fallback__summary">
      <view class="ashell-fallback__summary-item">
        <text class="ashell-fallback__summary-label">支出</text>
        <text class="ashell-fallback__summary-value ashell-fallback__summary-value--expense">¥ 0.00</text>
      </view>
      <view class="ashell-fallback__summary-item">
        <text class="ashell-fallback__summary-label">收入</text>
        <text class="ashell-fallback__summary-value ashell-fallback__summary-value--income">¥ 0.00</text>
      </view>
    </view>
  </view>

  <view class="ashell-fallback__tips">
    <view class="ashell-fallback__tip">记录每一笔日常收支</view>
    <view class="ashell-fallback__tip">按月查看消费趋势</view>
    <view class="ashell-fallback__tip">本地保存，简单安心</view>
  </view>
</view>
