.ashell-fallback {
  min-height: 100vh;
  padding: 56rpx 28rpx;
  background:
    radial-gradient(circle at 92% 0, rgba(38, 93, 255, 0.16), rgba(38, 93, 255, 0) 34%),
    radial-gradient(circle at 8% 22%, rgba(255, 139, 92, 0.12), rgba(255, 139, 92, 0) 28%),
    linear-gradient(180deg, #f6f8ff 0%, #eef3ff 100%);
  color: #1f2a44;
}

.ashell-fallback__hero {
  padding: 56rpx 36rpx 44rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 24rpx 60rpx rgba(37, 67, 154, 0.1);
}

.ashell-fallback__badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eaf0ff;
  color: #265dff;
  font-size: 22rpx;
  font-weight: 600;
}

.ashell-fallback__title {
  margin-top: 28rpx;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ashell-fallback__subtitle {
  margin-top: 16rpx;
  max-width: 560rpx;
  color: #6e7b98;
  font-size: 28rpx;
  line-height: 1.65;
}

.ashell-fallback__card {
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 50rpx rgba(37, 67, 154, 0.08);
}

.ashell-fallback__card-title {
  font-size: 30rpx;
  font-weight: 700;
}

.ashell-fallback__summary {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.ashell-fallback__summary-item {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7f9ff;
}

.ashell-fallback__summary-label {
  display: block;
  color: #6e7b98;
  font-size: 24rpx;
}

.ashell-fallback__summary-value {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.ashell-fallback__summary-value--expense {
  color: #f46b45;
}

.ashell-fallback__summary-value--income {
  color: #2a9d7f;
}

.ashell-fallback__tips {
  margin-top: 28rpx;
  display: grid;
  gap: 18rpx;
}

.ashell-fallback__tip {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #1f2a44;
  font-size: 28rpx;
}
