.mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9990;
  padding: 0 56rpx;
  background: rgba(0, 0, 0, 0.78);
  box-sizing: border-box;
}

.mask-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 58rpx 44rpx 52rpx;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(18, 22, 32, 0.82) 0%, rgba(24, 36, 42, 0.84) 100%);
  border: 1rpx solid rgba(60, 207, 207, 0.24);
  border-radius: 38rpx;
  box-shadow: 0 28rpx 70rpx rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(18rpx);
  box-sizing: border-box;
}

.player-unlock-icon-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 126rpx;
  background: linear-gradient(135deg, rgba(60, 207, 207, 0.22) 0%, rgba(46, 186, 186, 0.1) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  box-shadow: inset 0 0 30rpx rgba(255, 255, 255, 0.08), 0 18rpx 42rpx rgba(46, 186, 186, 0.18);
}

.player-unlock-icon {
  width: 70rpx;
  height: 70rpx;
}

.player-unlock-title {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.player-unlock-desc {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.42;
  text-align: center;
}

.player-unlock-action {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  padding: 18rpx 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #062f33;
  line-height: 1;
  background: linear-gradient(90deg, #78eeee 0%, #3ccfcf 100%);
  border-radius: 999rpx;
  box-shadow: 0 16rpx 34rpx rgba(60, 207, 207, 0.22);
}
