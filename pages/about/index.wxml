<view class="page-shell about-page">
  <view class="page-hero rise-card">
    <view class="hero-backdrop">
      <view class="hero-orb hero-orb-primary"></view>
      <view class="hero-orb hero-orb-secondary"></view>
    </view>
    <view class="page-title">关于{{appName}}</view>
  </view>

  <view class="card about-card rise-card" style="animation-delay: 0.06s;">
    <view class="section-title">核心能力</view>
    <view class="about-line">1. 首页集中展示本月收支、最近账单和快捷入口。</view>
