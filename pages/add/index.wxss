.form-card {
  padding: 28rpx;
}

.preview-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(234, 240, 255, 0.96) 0%, rgba(255, 255, 255, 0.96) 100%);
}

.preview-income {
  background: linear-gradient(135deg, rgba(42, 157, 127, 0.14) 0%, rgba(255, 255, 255, 0.96) 100%);
}

.preview-expense {
  background: linear-gradient(135deg, rgba(255, 139, 92, 0.16) 0%, rgba(255, 255, 255, 0.96) 100%);
}

.preview-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.preview-amount {
  display: block;
  margin-top: 16rpx;
  font-size: 46rpx;
  font-weight: 700;
}

.preview-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.form-block {
  margin-top: 28rpx;
}

.type-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.type-chip {
  height: 88rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(38, 93, 255, 0.08);
  background: rgba(255, 255, 255, 0.78);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.type-chip-active {
  background: linear-gradient(135deg, rgba(38, 93, 255, 0.14) 0%, rgba(255, 255, 255, 0.96) 100%);
  color: var(--brand);
}

.amount-shell {
  gap: 12rpx;
}

.prefix-symbol {
  font-size: 38rpx;
  font-weight: 700;
}

.amount-shell .amount-income {
  color: var(--income);
}

.amount-shell .amount-expense {
  color: var(--expense);
}

.amount-input {
  font-size: 36rpx;
  font-weight: 700;
}

.two-column-block {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.picker-shell {
  justify-content: center;
  font-size: 26rpx;
}

.submit-button {
  margin-top: 32rpx;
}

@media (max-width: 375px) {
  .two-column-block {
    grid-template-columns: 1fr;
  }
}
