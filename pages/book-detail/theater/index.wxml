<ashell-fallback wx:if="{{__ashellFallback}}" />
<view wx:if="{{__shellReady}}" class="theater-page {{showResumeCard ? 'theater-page--with-resume' : ''}}" style="background: {{pageBackground}};">
  <view class="theater-navbar {{platform.isWechat ? 'theater-navbar--fixed' : ''}}" style="height: {{platform.navBarTotalHeight}}px;">
    <view class="theater-navbar__inner"></view>
  </view>
  <view class="theater-navbar__placeholder" style="height: {{platform.navBarPlaceholderHeight}}px;"></view>

  <view wx:if="{{appStore.enableH5Page && switchTabs.length}}" class="switch-bar">
    <view class="switch-bar__inner">
      <view
        wx:for="{{switchTabs}}"
        wx:key="key"
        class="switch-item {{activeIndex === index ? 'switch-item--active' : ''}}"
        bindtap="changeActiveIndex"
        data-index="{{index}}"
      >
        {{item.text}}
      </view>
    </view>
  </view>

  <block wx:if="{{activeIndex === 0}}">
    <view wx:if="{{bannerList.length}}" class="banner-wrap">
      <swiper
        class="banner-swiper"
        current="{{swiperIndex}}"
        bindanimationfinish="handleSwiperAnimationFinish"
        bindchange="handleSwiperChange"
        indicator-dots
        indicator-color="rgba(255,255,255,0.3)"
        indicator-active-color="#ffffff"
        interval="5000"
        autoplay="{{true}}"
        previous-margin="20px"
        next-margin="20px"
      >
        <swiper-item wx:for="{{bannerList}}" wx:key="id" class="banner-item" bindtap="handleBannerTap" data-index="{{index}}">
          <view class="banner-card {{currentSwiperIndex === index ? 'banner-card--active' : 'banner-card--normal'}}">
            <image class="banner-image" src="{{item.cover}}" mode="aspectFill"></image>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view wx:if="{{goodList.length}}" class="section">
      <view class="section-title">
        <image wx:if="{{goodSection.title_icon}}" class="section-title__icon" src="{{goodSection.title_icon}}" mode="aspectFit"></image>
        <view class="section-title__text">{{goodSection.title}}</view>
      </view>
      <view class="grid-list">
        <view wx:for="{{goodList}}" wx:key="id" class="grid-item" bindtap="handlePlayTap" data-id="{{item.id}}">
          <image class="grid-item__cover" src="{{item.cover}}" mode="aspectFill"></image>
          <view class="grid-item__title">{{item.title}}</view>
          <view class="grid-item__update">{{item.update_text}}</view>
        </view>
      </view>
    </view>

    <swiper wx:if="{{hotList.length}}" class="hot-swiper" display-multiple-items="1" next-margin="70rpx">
      <swiper-item wx:for="{{hotList}}" wx:key="title" class="hot-swiper__item">
        <view class="section hot-section">
          <view class="section-title">
            <image wx:if="{{hotSection.title_icon}}" class="section-title__icon" src="{{hotSection.title_icon}}" mode="aspectFit"></image>
            <view class="section-title__text">{{item.title}}</view>
          </view>
          <view wx:for="{{item.list}}" wx:key="id" wx:for-item="drama" class="hot-item">
            <image class="hot-item__cover" src="{{drama.cover}}" mode="aspectFill"></image>
            <view class="hot-item__content">
              <view class="hot-item__main">
                <view class="hot-item__title">{{drama.title}}</view>
                <view class="hot-item__update">{{drama.update_text}}</view>
              </view>
              <view class="hot-item__action" bindtap="handlePlayTap" data-id="{{drama.id}}">
                {{drama.actionText || (hotSection.item_schema && hotSection.item_schema.action_text)}}
              </view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <load-more status="{{loadingStatus}}"></load-more>
  </block>

  <block wx:else>
    <view wx:if="{{yearGoodList.length}}" class="section">
      <view class="section-title">
        <image wx:if="{{yearSection.title_icon}}" class="section-title__icon" src="{{yearSection.title_icon}}" mode="aspectFit"></image>
        <view class="section-title__text">{{yearSection.title}}</view>
      </view>
      <view class="grid-list">
        <view wx:for="{{yearGoodList}}" wx:key="id" class="grid-item" bindtap="handleWebPlayTap" data-id="{{item.id}}">
          <image class="grid-item__cover" src="{{item.cover}}" mode="aspectFill"></image>
          <view class="grid-item__title">{{item.title}}</view>
          <view class="grid-item__update">{{item.update_text}}</view>
        </view>
      </view>
    </view>
    <load-more status="{{yearLoadingStatus}}"></load-more>
  </block>

  <revenue-dialog
    visible="{{revenueDialogVisible}}"
    hot-list="{{hotList}}"
    config="{{revenueDialogConfig}}"
    bindclose="closeRevenueDialog"
    bindplaydrama="handleRevenueDramaTap"
  />

  <view
    wx:if="{{showResumeCard && resumeCard}}"
    class="resume-float-card"
    bindtap="handleResumeCardTap"
    hover-class="resume-float-card--pressed"
    hover-stay-time="80"
  >
    <view class="resume-float-card__glow resume-float-card__glow--left"></view>
    <view class="resume-float-card__glow resume-float-card__glow--right"></view>

    <view class="resume-float-card__close" catchtap="handleResumeCardClose">
      <text class="resume-float-card__close-icon">×</text>
    </view>

    <view class="resume-float-card__cover-wrap">
      <image class="resume-float-card__cover" src="{{resumeCard.cover}}" mode="aspectFill"></image>
      <view class="resume-float-card__playing">
        <view class="resume-float-card__playing-bar resume-float-card__playing-bar--1"></view>
        <view class="resume-float-card__playing-bar resume-float-card__playing-bar--2"></view>
        <view class="resume-float-card__playing-bar resume-float-card__playing-bar--3"></view>
      </view>
    </view>

    <view class="resume-float-card__content">
      <view class="resume-float-card__meta">
        <view class="resume-float-card__eyebrow">{{resumeCard.eyebrow || '上次看到'}}</view>
        <view class="resume-float-card__live-dot"></view>
      </view>
      <view class="resume-float-card__title">{{resumeCard.title}}</view>
      <view class="resume-float-card__progress-row">
        <view class="resume-float-card__progress">{{resumeCard.progressText}}</view>
        <view class="resume-float-card__progress-line"></view>
      </view>
    </view>

    <view class="resume-float-card__action">
      <view class="resume-float-card__action-circle">
        <view class="resume-float-card__action-icon"></view>
      </view>
      <text class="resume-float-card__action-text">续看</text>
    </view>
  </view>

  <detail-tab-bar tabs="{{tabBarItems}}" />
</view>
