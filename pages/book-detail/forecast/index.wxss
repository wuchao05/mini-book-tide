.forecast-page {
  width: 100%;
  height: 100vh;
  background: #000000;
  position: fixed;
  top: 0;
  left: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.page-bottom-bar {
  height: 110rpx;
  background: rgba(0, 0, 0, 0.9);
  padding: 10rpx 32rpx 0;
  z-index: 9990;
  display: flex;
  justify-content: space-between;
}

.page-bottom-bar-left,
.page-bottom-bar-right {
  display: flex;
  align-items: center;
}

.page-bottom-bar-image {
  width: 64rpx;
  height: 92rpx;
  border-radius: 4rpx;
  overflow: hidden;
  margin-right: 18rpx;
}

.page-bottom-bar-image image {
  width: 100%;
  height: 100%;
}

.page-bottom-bar-desc {
  font-size: 24rpx;
  color: #cccccc;
  font-weight: 500;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}

.page-bottom-bar-desc image {
  width: 24rpx;
  height: 24rpx;
  position: relative;
  top: 2rpx;
}

.page-bottom-bar-title {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
  margin-top: 4rpx;
}

.page-bottom-bar-selection {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx 14rpx 22rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
}

.page-bottom-bar-selection__label {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.page-bottom-bar-selection__meta {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1;
}

.page-bottom-bar-selection__icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.white-screen {
  width: 100vw;
  height: 100vh;
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #000000;
  font-weight: bold;
}
