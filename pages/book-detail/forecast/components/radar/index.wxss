.player-wrapper {
  width: 100%;
  height: calc(100vh - 134rpx);
  position: relative;
  background: #000000;
  overflow: hidden;
}

.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 152rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 16rpx;
  background: linear-gradient(rgba(0, 0, 0, 0.6), transparent);
  z-index: 10000;
}

.back-btn,
.placeholder {
  width: 40rpx;
  height: 40rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.video-swiper {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.video-slide {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000000;
}

.video-player,
.video-cover {
  width: 100%;
  height: 100%;
}

.video-hidden {
  opacity: 0;
  pointer-events: none;
}

.center-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 20;
}

.play-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.9;
}

.player-control-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  z-index: 200;
}

.control-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 8rpx;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-text,
.time-sep,
.episode-tag {
  font-size: 24rpx;
}

.time-text {
  color: #ffffff;
}

.time-sep {
  color: rgba(255, 255, 255, 0.6);
}

.episode-tag {
  color: rgba(255, 255, 255, 0.9);
}

.progress-area {
  padding: 0 32rpx;
}

.progress-slider {
  width: 100%;
  margin: 0;
}
