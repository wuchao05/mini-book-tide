.episode-detail-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.62);
}

.episode-detail {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 880rpx;
  max-height: 82vh;
  overflow: hidden;
  background: linear-gradient(180deg, #f7ffff 0%, #ffffff 44%, #f8f8fa 100%);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -24rpx 60rpx rgba(0, 0, 0, 0.18);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.episode-detail-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 18rpx auto 4rpx;
  background: rgba(18, 22, 32, 0.12);
  border-radius: 999rpx;
}

.close-btn {
  position: absolute;
  top: 22rpx;
  right: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  z-index: 10;
}

.close-icon {
  margin-top: -4rpx;
  font-size: 46rpx;
  font-weight: 300;
  color: rgba(18, 22, 32, 0.42);
  line-height: 1;
}

.episode-detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 28rpx 36rpx 0;
}

.header-cover {
  flex-shrink: 0;
  width: 108rpx;
  height: 150rpx;
  margin-right: 24rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 22rpx;
  box-shadow: 0 12rpx 28rpx rgba(18, 22, 32, 0.14);
}

.header-info {
  flex: 1;
  min-width: 0;
  padding-right: 70rpx;
}

.header-title {
  overflow: hidden;
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #121620;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-subtitle {
  overflow: hidden;
  font-size: 24rpx;
  color: #696d78;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.episode-detail-tabs {
  margin-bottom: 24rpx;
  padding: 0 36rpx;
}

.tabs-scroll {
  white-space: nowrap;
  width: 100%;
}

.tab-item {
  display: inline-block;
  padding: 14rpx 26rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #696d78;
  background: #f1f3f5;
  border-radius: 999rpx;
  white-space: nowrap;
}

.tab-item.active {
  color: #062f33;
  background: linear-gradient(90deg, #78eeee 0%, #3ccfcf 100%);
  box-shadow: 0 10rpx 24rpx rgba(60, 207, 207, 0.18);
}

.episode-detail-content {
  flex: 1;
  min-height: 0;
  padding: 0 36rpx 44rpx;
  overflow: hidden;
}

.episode-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
}

.episode-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 86rpx;
  background: #ffffff;
  border: 1rpx solid #e9edf2;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(18, 22, 32, 0.035);
  box-sizing: border-box;
}

.episode-item.locked {
  background: #f0f2f5;
  border-color: #e1e5ea;
  box-shadow: none;
}

.episode-item.locked .episode-no {
  color: #8b929f;
}

.episode-item.current {
  background: linear-gradient(135deg, #3ccfcf 0%, #2ebaba 100%);
  border-color: transparent;
  box-shadow: 0 12rpx 26rpx rgba(60, 207, 207, 0.2);
}

.episode-item.current .episode-no {
  color: #ffffff;
  font-weight: 800;
}

.episode-item.current-locked {
  background: #e9fbfb;
  border-color: #3ccfcf;
  box-shadow: 0 10rpx 24rpx rgba(60, 207, 207, 0.14);
}

.episode-item.current-locked .episode-no {
  color: #1f8f8f;
  font-weight: 800;
}

.episode-no {
  font-size: 27rpx;
  color: #121620;
  font-weight: 700;
  line-height: 1;
}

.lock-badge {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  top: 8rpx;
  right: 8rpx;
  width: 26rpx;
  height: 26rpx;
  background: rgba(18, 22, 32, 0.22);
  border-radius: 50%;
}

.episode-item.current-locked .lock-badge {
  background: #3ccfcf;
}

.lock-icon {
  width: 18rpx;
  height: 18rpx;
}
