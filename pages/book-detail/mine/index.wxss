@import "../../../app.wxss";

.mine-page {
  min-height: 100vh;
  padding-bottom: calc(172rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f8f8fa;
}

.mine-header {
  position: relative;
}

.mine-header__bg {
  width: 100%;
  height: 300rpx;
}

.mine-header__content {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  width: 100%;
  padding: 0 40rpx;
}

.mine-header__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.mine-header__info {
  flex: 1;
  margin-left: 14rpx;
}

.mine-header__name {
  overflow: hidden;
  font-size: 36rpx;
  font-weight: 600;
  color: #121620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-header__id {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9fa3ae;
}

.account-wrap {
  display: flex;
  justify-content: space-between;
  padding: 40rpx;
}

.account-card {
  width: 323rpx;
  min-height: 292rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.account-card__icon {
  width: 80rpx;
  height: 80rpx;
}

.account-card__label {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #9fa3ae;
}

.account-card__value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.account-card__value {
  font-size: 60rpx;
  font-weight: 600;
  color: #121620;
}

.account-card__action {
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1f8f8f;
  background: rgba(60, 207, 207, 0.12);
  border: 1rpx solid rgba(60, 207, 207, 0.3);
  border-radius: 999rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.account-card__action-icon {
  width: 12rpx;
  height: 12rpx;
  margin-left: 10rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.menu-list {
  margin: 0 40rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx;
}

.customer-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 40rpx 32rpx;
  margin: 0;
}

.customer-item__main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.customer-item__icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.customer-item__name {
  margin-left: 30rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #121620;
  white-space: nowrap;
}

.customer-item__sub {
  margin-left: 20rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #999999;
}

.customer-item__arrow {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.customer-item__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  opacity: 0;
}

.customer-item__overlay::after {
  border: 0;
}

.menu-item__left {
  display: flex;
  align-items: center;
  flex: 1;
}

.menu-item__icon {
  width: 48rpx;
  height: 48rpx;
}

.menu-item__content {
  display: flex;
  align-items: center;
}

.menu-item__title {
  margin-left: 30rpx;
  font-size: 32rpx;
  color: #121620;
  white-space: nowrap;
}

.menu-item__sub {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #999999;
}

.menu-item__arrow {
  width: 48rpx;
  height: 48rpx;
}
