.follow-page {
  min-height: 100vh;
  padding-top: 220rpx;
  padding-bottom: calc(172rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
}

.follow-loading,
.follow-loading-more {
  padding: 40rpx 0;
  font-size: 28rpx;
  color: #696d78;
  text-align: center;
}

.follow-content {
  padding: 0 40rpx 40rpx;
}

.follow-item {
  display: flex;
  margin-bottom: 40rpx;
}

.follow-item__cover-wrap {
  position: relative;
  width: 160rpx;
  height: 240rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.follow-item__cover {
  width: 100%;
  height: 100%;
}

.follow-item__tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 6rpx 10rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(18, 22, 32, 0.45);
  border-radius: 16rpx;
}

.follow-item__content {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 32rpx;
  padding-top: 20rpx;
}

.follow-item__title {
  overflow: hidden;
  font-size: 36rpx;
  font-weight: 600;
  color: #121620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.follow-item__update {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9fa3ae;
}

.follow-item__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.follow-item__progress {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #121620;
}

.follow-item__progress-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
}

.follow-item__button {
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  background: linear-gradient(90deg, #3ccfcf 0%, #2ebaba 100%);
  border-radius: 20rpx;
}
