.overview-card {
  padding: 28rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.overview-item {
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(38, 93, 255, 0.08);
}

.overview-item-wide {
  grid-column: span 2;
  background: linear-gradient(135deg, rgba(234, 240, 255, 0.96) 0%, rgba(255, 246, 240, 0.92) 100%);
}

.overview-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.overview-value {
  display: block;
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.quick-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.quick-card {
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-card-brand {
  background: linear-gradient(180deg, rgba(38, 93, 255, 0.96) 0%, rgba(58, 110, 255, 0.92) 100%);
  border-color: rgba(38, 93, 255, 0.18);
}

.quick-card-brand .quick-title {
  color: #ffffff;
}

.quick-title {
  font-size: 32rpx;
  font-weight: 700;
}

.list-section {
  margin-top: 24rpx;
}

.filter-row {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.bill-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bill-item {
  padding: 24rpx;
}

.bill-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bill-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.bill-dot {
  width: 22rpx;
  height: 22rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.bill-dot-income {
  background: var(--income);
  box-shadow: 0 0 0 8rpx rgba(42, 157, 127, 0.12);
}

.bill-dot-expense {
  background: var(--expense);
  box-shadow: 0 0 0 8rpx rgba(244, 107, 69, 0.12);
}

.bill-copy {
  flex: 1;
  min-width: 0;
}

.bill-topline {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.bill-category {
  font-size: 30rpx;
  font-weight: 700;
}

.bill-note {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.bill-right {
  text-align: right;
  flex-shrink: 0;
}

.bill-amount {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.bill-date {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.empty-button {
  margin-top: 22rpx;
}

@media (max-width: 375px) {
  .overview-grid,
  .quick-row {
    grid-template-columns: 1fr;
  }

  .overview-item-wide {
    grid-column: span 1;
  }

  .bill-main {
    flex-direction: column;
    align-items: stretch;
  }

  .bill-right {
    text-align: left;
  }
}
