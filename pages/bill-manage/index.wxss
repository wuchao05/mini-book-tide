.summary-card {
  padding: 28rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.summary-item {
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(247, 249, 255, 0.94);
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.summary-value {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.filter-row {
  margin-top: 22rpx;
  margin-bottom: 22rpx;
}

.manage-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.manage-item {
  padding: 24rpx;
}

.manage-main {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.manage-left {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 16rpx;
}

.manage-mark {
  width: 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.manage-mark-income {
  background: linear-gradient(180deg, rgba(42, 157, 127, 0.24) 0%, var(--income) 100%);
}

.manage-mark-expense {
  background: linear-gradient(180deg, rgba(244, 107, 69, 0.24) 0%, var(--expense) 100%);
}

.manage-copy {
  flex: 1;
}

.manage-topline {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.manage-category {
  font-size: 30rpx;
  font-weight: 700;
}

.manage-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.manage-right {
  text-align: right;
  flex-shrink: 0;
}

.manage-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.manage-date {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.manage-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(38, 93, 255, 0.08);
}

.delete-button {
  min-width: 112rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(244, 107, 69, 0.12);
  color: var(--expense);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.delete-button::after {
  border: 0;
}

.empty-button {
  margin-top: 22rpx;
}

@media (max-width: 375px) {
  .summary-grid {
    grid-template-columns: 1fr;
  }

  .manage-main {
    flex-direction: column;
  }

  .manage-right {
    text-align: left;
  }
}
