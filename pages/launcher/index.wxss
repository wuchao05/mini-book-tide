.launcher-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 16%, rgba(38, 93, 255, 0.18), transparent 32%),
    radial-gradient(circle at 82% 76%, rgba(255, 139, 92, 0.12), transparent 30%),
    linear-gradient(180deg, var(--bg-top, #f6f8ff) 0%, var(--bg-bottom, #eef3ff) 100%);
}

.launcher-page__orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  animation: launcher-float 5.8s ease-in-out infinite;
}

.launcher-page__orb--primary {
  top: 136rpx;
  left: 58rpx;
  width: 196rpx;
  height: 196rpx;
  background: radial-gradient(circle, rgba(38, 93, 255, 0.24) 0%, rgba(38, 93, 255, 0.02) 74%);
}

.launcher-page__orb--secondary {
  top: 242rpx;
  right: 44rpx;
  width: 116rpx;
  height: 116rpx;
  background: radial-gradient(circle, rgba(255, 139, 92, 0.26) 0%, rgba(255, 139, 92, 0.02) 76%);
  animation-delay: -1.6s;
}

.launcher-page__orb--tertiary {
  right: 112rpx;
  bottom: 132rpx;
  width: 250rpx;
  height: 250rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.84) 0%, rgba(255, 255, 255, 0.02) 72%);
  animation-delay: -2.8s;
}

.launcher-page__card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 580rpx;
  padding: 58rpx 44rpx 50rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(38, 93, 255, 0.08);
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 24rpx 60rpx rgba(37, 67, 154, 0.12);
  backdrop-filter: blur(18rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: launcher-rise 520ms ease-out both;
}

.launcher-page__badge-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.launcher-page__badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(38, 93, 255, 0.08);
  font-size: 22rpx;
  color: var(--brand, #265dff);
}

.launcher-page__badge--accent {
  color: var(--accent, #ff8b5c);
  border-color: rgba(255, 139, 92, 0.14);
}

.launcher-page__badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
  animation: launcher-pulse 1.6s ease-in-out infinite;
}

.launcher-page__badge-dot--accent {
  animation-delay: -0.8s;
}

.launcher-page__loader {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.launcher-page__loader-ring {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(38, 93, 255, 0.14);
  border-top-color: var(--brand, #265dff);
  border-right-color: rgba(255, 139, 92, 0.68);
  animation: launcher-spin 900ms linear infinite;
}

.launcher-page__loader-core {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, var(--brand, #265dff) 0%, var(--accent, #ff8b5c) 100%);
  box-shadow: 0 0 28rpx rgba(38, 93, 255, 0.34);
  animation: launcher-core 1.25s ease-in-out infinite;
}

.launcher-page__title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--text-primary, #1f2a44);
  text-align: center;
}

.launcher-page__subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6e7b98);
  text-align: center;
}

.launcher-page__bars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 34rpx;
}

.launcher-page__bar {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(38, 93, 255, 0.9) 0%, rgba(255, 139, 92, 0.9) 100%);
  animation: launcher-breathe 1.35s ease-in-out infinite;
}

.launcher-page__bar--two {
  animation-delay: 0.15s;
}

.launcher-page__bar--three {
  animation-delay: 0.3s;
}

@keyframes launcher-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes launcher-core {
  0%,
  100% {
    transform: scale(0.82);
    opacity: 0.68;
  }

  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

@keyframes launcher-breathe {
  0%,
  100% {
    transform: translateY(0) scale(0.78);
    opacity: 0.5;
  }

  50% {
    transform: translateY(-10rpx) scale(1);
    opacity: 1;
  }
}

@keyframes launcher-rise {
  from {
    transform: translateY(18rpx);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes launcher-float {
  0%,
  100% {
    transform: translate3d(0, 0, 0) scale(1);
  }

  50% {
    transform: translate3d(0, -22rpx, 0) scale(1.04);
  }
}
