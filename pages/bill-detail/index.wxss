.amount-card,
.info-card {
  padding: 28rpx;
}

.amount-card {
  background: linear-gradient(135deg, rgba(234, 240, 255, 0.96) 0%, rgba(255, 255, 255, 0.94) 100%);
}

.amount-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.amount-value {
  display: block;
  margin-top: 18rpx;
  font-size: 60rpx;
  font-weight: 700;
}

.info-card {
  margin-top: 22rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(38, 93, 255, 0.08);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-key {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
}

.detail-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.empty-button {
  margin-top: 22rpx;
}

@media (max-width: 375px) {
  .detail-actions {
    grid-template-columns: 1fr;
  }
}
